{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desktop Assistant",
  "version": "0.1.0",
  "identifier": "com.example.ai-desktop-assistant",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "MIT",
    "shortDescription": "Local-first AI desktop assistant",
    "longDescription": "Open-source Rust + Tauri desktop AI assistant with local models",
    "publisher": "AI Desktop Assistant"
  }
}
